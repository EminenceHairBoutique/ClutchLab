# ClutchLab environment. Copy to .env (gitignored) and fill in what you have.
# Validation lives in packages/config/src/env.ts — production REQUIRES the
# Supabase values and refuses AUTH_MOCK; dev/test run in visible mock-auth mode
# when Supabase is absent.

# --- Runtime -----------------------------------------------------------------
# Overrides NODE_ENV for env-rule purposes (development | test | production).
# Set APP_ENV=test for verification builds without production credentials (CI does this).
APP_ENV=
# Public base URL of the app (OAuth redirects, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (create a project at https://supabase.com) ---------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side ONLY. Never expose to the client or commit anywhere.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for `pnpm db:migrate` / `pnpm db:seed`
# (Supabase dashboard → Database → Connection string, or any local Postgres).
DATABASE_URL=

# --- Auth options ------------------------------------------------------------
# Force the in-memory mock auth adapter in dev/test (forbidden in production).
AUTH_MOCK=
# Show OAuth buttons once the provider is configured in the Supabase dashboard.
NEXT_PUBLIC_AUTH_GOOGLE=
NEXT_PUBLIC_AUTH_APPLE=

# --- AI coach (optional; absent -> clearly-labeled mock provider) ------------
# Anthropic API key for the post-match coach. Server/worker side only.
ANTHROPIC_API_KEY=
# REQUIRED when ANTHROPIC_API_KEY is set. Model IDs come from config, never code.
AI_COACH_MODEL=

# --- Billing (optional; absent -> mock billing, dev/test only) ---------------
# Server-side only. Setting the secret key REQUIRES the other three.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe price IDs for the paid plans (create in the Stripe dashboard).
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# --- Web push (optional; §5.18 — in-app inbox works without these) -----------
# Generate the pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services.
VAPID_SUBJECT=

# --- Error monitoring (optional; disabled when empty) ------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Tests -------------------------------------------------------------------
# Optional: point RLS integration tests at a THROWAWAY superuser Postgres
# instead of auto-booting a local cluster (CI uses a service container).
TEST_DATABASE_URL=
