{
  "name": "clutchlab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "e2e": "turbo run e2e",
    "db:migrate": "pnpm --filter @clutchlab/db run migrate",
    "db:seed": "pnpm --filter @clutchlab/db run seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
